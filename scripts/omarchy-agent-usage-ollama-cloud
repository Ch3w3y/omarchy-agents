#!/usr/bin/python3
# omarchy:summary=Print the Ollama Cloud usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Ollama Cloud session/weekly usage into one display-ready JSON
record.

Ollama Cloud has no documented usage API — this calls the same undocumented
`https://ollama.com/api/usage` endpoint community tooling (e.g.
pi-ollama-cloud) already uses, and degrades to a plain "unavailable" card
rather than a crash if the shape ever drifts. No reset timestamps are in
that response, only 0-1 usage fractions per window, so limits here show a
percentage without a countdown. No local session/token data exists for a
hosted API, so this collector is limits-only.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

AGENT_ID = "ollama-cloud"
AGENT_NAME = "Ollama Cloud"
AUTH_HELP = "Create a key at https://ollama.com/settings/keys, then add it from the panel's gear icon (or set OLLAMA_API_KEY)."
USAGE_ENDPOINT = "https://ollama.com/api/usage"
PROBE_MIN_INTERVAL_SECONDS = 20
HTTP_TIMEOUT = 10

WINDOWS = (("session", "Session (5-hour)", "Session"), ("weekly", "Weekly (7-day)", "Weekly"))


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def number(value: Any) -> float:
  try:
    n = float(value)
    return n if n == n and abs(n) != float("inf") else 0.0
  except Exception:
    return 0.0


def read_json(path: Path) -> dict[str, Any] | None:
  try:
    data = json.loads(path.read_text(encoding="utf-8"))
    return data if isinstance(data, dict) else None
  except Exception:
    return None


def write_json(path: Path, data: dict[str, Any]) -> None:
  tmp = path.with_name(path.name + ".tmp")
  tmp.write_text(json.dumps(data), encoding="utf-8")
  tmp.replace(path)


def data_home() -> Path:
  return Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))


def config_home() -> Path:
  return Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))


# The Agents panel's own settings screen (the gear icon) writes keys here via
# omarchy-agent-credential-set.
def agents_credential(provider_id: str) -> str:
  data = read_json(config_home() / "omarchy" / "agents" / "credentials.json")
  if not data:
    return ""
  entry = data.get(provider_id)
  if isinstance(entry, dict):
    return str(entry.get("apiKey") or "").strip()
  return ""


# The `pi` CLI's own Ollama Cloud integration stores its key the same way
# opencode stores per-provider credentials; reuse it if `ollama signin`
# hasn't also left OLLAMA_API_KEY exported somewhere in the environment.
def pi_auth_key() -> str:
  data = read_json(Path.home() / ".pi" / "agent" / "auth.json")
  if not data:
    return ""
  entry = data.get("ollama-cloud")
  if isinstance(entry, dict):
    return str(entry.get("key") or "").strip()
  return ""


def opencode_auth_key() -> str:
  data = read_json(data_home() / "opencode" / "auth.json")
  if not data:
    return ""
  for id_variant in ("ollama-cloud", "ollama"):
    entry = data.get(id_variant)
    if isinstance(entry, dict):
      key = str(entry.get("key") or "").strip()
      if key:
        return key
  return ""


def api_key() -> str:
  env = os.environ.get("OLLAMA_API_KEY", "").strip()
  if env:
    return env
  from_pi = pi_auth_key()
  if from_pi:
    return from_pi
  from_opencode = opencode_auth_key()
  if from_opencode:
    return from_opencode
  return agents_credential(AGENT_ID)


def probe(key: str) -> dict[str, Any]:
  req = urllib.request.Request(
    USAGE_ENDPOINT,
    headers={"Authorization": f"Bearer {key}", "Accept": "application/json", "User-Agent": "omarchy-agents/1.0"},
  )
  try:
    with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as response:
      payload = json.loads(response.read().decode("utf-8", errors="replace"))
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      return {"ok": False, "helpText": "Ollama Cloud rejected the API key. " + AUTH_HELP}
    if error.code == 429:
      return {"ok": False, "helpText": "Ollama Cloud is rate limiting usage checks right now."}
    if error.code == 404:
      return {"ok": False, "helpText": "Ollama Cloud's usage endpoint is undocumented and may have moved."}
    return {"ok": False, "helpText": f"Ollama Cloud's usage endpoint returned status {error.code}."}
  except Exception:
    return {"ok": False, "transport": True, "helpText": "Couldn't reach Ollama Cloud. Retrying shortly."}

  raw_limits = payload.get("limits") if isinstance(payload, dict) else None
  if not isinstance(raw_limits, dict):
    return {"ok": False, "helpText": "Ollama Cloud's usage response didn't match what this collector expects."}

  limits: list[dict[str, Any]] = []
  for key_name, label, title in WINDOWS:
    window = raw_limits.get(key_name)
    if not isinstance(window, dict):
      continue
    usage = window.get("usage")
    if not isinstance(usage, (int, float)):
      continue
    # The panel's `percent` contract is a 0-1 fraction (it multiplies by 100
    # to display and alarms at >= 0.9) — Ollama's `usage` is already 0-1.
    percent = max(0.0, min(1.0, float(usage)))
    limits.append({"label": label, "title": title, "percent": percent, "resetsAt": ""})

  if not limits:
    return {"ok": False, "helpText": "Ollama Cloud's usage endpoint returned no usage windows."}
  return {"ok": True, "limits": limits}


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true", help="ignore the short reuse window and re-probe")
  parser.add_argument("--limits-only", action="store_true", help="accepted for contract parity; every probe here is a limits probe")
  args = parser.parse_args()

  cache_path = cache_root() / f"{AGENT_ID}.json"
  cached = read_json(cache_path) or {}
  fetched_at = number(cached.get("fetchedAtMs")) / 1000
  fallback = cached.get("record") if isinstance(cached.get("record"), dict) else None

  now = dt.datetime.now(dt.timezone.utc).isoformat()
  key = api_key()

  if key == "":
    record = dict(fallback or {})
    record.update({
      "schemaVersion": 1,
      "id": AGENT_ID,
      "name": AGENT_NAME,
      "updatedAt": now,
      "ready": bool(fallback and fallback.get("limits")),
      "hasLocalStats": False,
      "hasPromptStats": False,
      "tierLabel": AGENT_NAME,
      "usageStatusText": "Waiting for auth",
      "authHelpText": AUTH_HELP,
    })
    record.setdefault("limits", [])
    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0

  if not args.force and fallback and time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS:
    print(json.dumps(fallback, separators=(",", ":"), sort_keys=True))
    return 0

  probed = probe(key)

  if not probed["ok"]:
    record = dict(fallback) if fallback else {
      "schemaVersion": 1,
      "id": AGENT_ID,
      "name": AGENT_NAME,
      "hasLocalStats": False,
      "hasPromptStats": False,
      "ready": False,
      "tierLabel": AGENT_NAME,
      "limits": [],
    }
    record["updatedAt"] = now
    record["usageStatusText"] = "" if fallback else "Ollama Cloud usage unavailable"
    record["authHelpText"] = probed["helpText"]
    if probed.get("transport"):
      record["retryAdvised"] = True
    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": now,
    "ready": True,
    "hasLocalStats": False,
    "hasPromptStats": False,
    "tierLabel": AGENT_NAME,
    "usageStatusText": "",
    "authHelpText": "",
    "limits": probed["limits"],
  }

  write_json(cache_path, {"fetchedAtMs": round(time.time() * 1000), "record": record})
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
