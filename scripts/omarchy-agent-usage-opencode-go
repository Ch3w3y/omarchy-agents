#!/usr/bin/python3
# omarchy:summary=Print the OpenCode Go usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect OpenCode Go subscription usage into one display-ready JSON record.

OpenCode Go is the hosted model-access subscription behind `opencode auth
login`, distinct from any one model provider. Its rolling/weekly/monthly
usage windows come from `https://opencode.ai/zen/go/v1/usage`; there is no
per-session or per-token local data to report alongside them, so this
collector is limits-only.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

AGENT_ID = "opencode-go"
AGENT_NAME = "OpenCode Go"
AUTH_HELP = "Run `opencode auth login` and choose OpenCode Go, or add a key from the panel's gear icon."
USAGE_ENDPOINT = "https://opencode.ai/zen/go/v1/usage"
PROBE_MIN_INTERVAL_SECONDS = 20
HTTP_TIMEOUT = 10

WINDOWS = (("rolling", "Rolling (5-hour)", "Rolling"), ("weekly", "Weekly (7-day)", "Weekly"), ("monthly", "Monthly", "Monthly"))


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def number(value: Any) -> float:
  try:
    n = float(value)
    return n if n == n and abs(n) != float("inf") else 0.0
  except Exception:
    return 0.0


def read_json(path: Path) -> dict[str, Any] | None:
  try:
    data = json.loads(path.read_text(encoding="utf-8"))
    return data if isinstance(data, dict) else None
  except Exception:
    return None


def write_json(path: Path, data: dict[str, Any]) -> None:
  tmp = path.with_name(path.name + ".tmp")
  tmp.write_text(json.dumps(data), encoding="utf-8")
  tmp.replace(path)


def toml_value(path: Path, section: str, key: str) -> str:
  try:
    text = path.read_text(encoding="utf-8")
  except Exception:
    return ""
  in_section = False
  pattern = re.compile(r'^' + re.escape(key) + r'\s*=\s*"(.*)"\s*$')
  for line in text.splitlines():
    stripped = line.strip()
    if stripped.startswith("["):
      in_section = stripped == f"[{section}]"
      continue
    if not in_section:
      continue
    match = pattern.match(stripped)
    if match:
      return match.group(1)
  return ""


def config_home() -> Path:
  return Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))


def data_home() -> Path:
  return Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share"))


# opencode itself signs in to OpenCode Go via `opencode auth login`, which
# lands the key in its own credential store keyed by provider id — the same
# file Fireworks' collector already reads for an opencode-stored key.
def opencode_auth_key() -> str:
  data = read_json(data_home() / "opencode" / "auth.json")
  if not data:
    return ""
  entry = data.get("opencode-go")
  if isinstance(entry, dict):
    return str(entry.get("key") or "").strip()
  return ""


# The Agents panel's own settings screen (the gear icon) writes keys here via
# omarchy-agent-credential-set.
def agents_credential(provider_id: str) -> str:
  data = read_json(config_home() / "omarchy" / "agents" / "credentials.json")
  if not data:
    return ""
  entry = data.get(provider_id)
  if isinstance(entry, dict):
    return str(entry.get("apiKey") or "").strip()
  return ""


def api_key() -> str:
  env = os.environ.get("OPENCODE_GO_API_KEY", "").strip()
  if env:
    return env
  from_opencode = opencode_auth_key()
  if from_opencode:
    return from_opencode
  from_settings = agents_credential(AGENT_ID)
  if from_settings:
    return from_settings
  toml_path = config_home() / "ai-usagebar" / "config.toml"
  return toml_value(toml_path, "opencode-go", "api_key").strip()


def probe(key: str) -> dict[str, Any]:
  req = urllib.request.Request(
    USAGE_ENDPOINT,
    # Cloudflare in front of opencode.ai bot-fingerprints on User-Agent and
    # bans Python's default `Python-urllib/…` signature outright (403,
    # error 1010) before auth is even checked — a real client string clears
    # it.
    headers={"Authorization": f"Bearer {key}", "Accept": "application/json", "User-Agent": "omarchy-agents/1.0"},
  )
  try:
    with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as response:
      payload = json.loads(response.read().decode("utf-8", errors="replace"))
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      return {"ok": False, "helpText": "OpenCode Go rejected the API key. " + AUTH_HELP}
    if error.code == 429:
      return {"ok": False, "helpText": "OpenCode Go is rate limiting usage checks right now."}
    return {"ok": False, "helpText": f"OpenCode Go's usage endpoint returned status {error.code}."}
  except Exception:
    return {"ok": False, "transport": True, "helpText": "Couldn't reach OpenCode Go. Retrying shortly."}

  usage = payload.get("usage") if isinstance(payload, dict) else None
  if not isinstance(usage, dict) or payload.get("error"):
    return {"ok": False, "helpText": "OpenCode Go's usage response didn't match what this collector expects."}

  limits: list[dict[str, Any]] = []
  for key_name, label, title in WINDOWS:
    window = usage.get(key_name)
    if not isinstance(window, dict):
      continue
    percent = window.get("percent")
    if not isinstance(percent, (int, float)):
      continue
    resets_at = str(window.get("resetsAt") or "")
    # The panel's `percent` contract is a 0-1 fraction (it multiplies by 100
    # to display and alarms at >= 0.9) — OpenCode Go's API reports 0-100.
    limits.append({"label": label, "title": title, "percent": max(0.0, min(1.0, float(percent) / 100.0)), "resetsAt": resets_at})

  if not limits:
    return {"ok": False, "helpText": "OpenCode Go's usage endpoint returned no usage windows."}
  return {"ok": True, "limits": limits}


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true", help="ignore the short reuse window and re-probe")
  parser.add_argument("--limits-only", action="store_true", help="accepted for contract parity; every probe here is a limits probe")
  args = parser.parse_args()

  cache_path = cache_root() / f"{AGENT_ID}.json"
  cached = read_json(cache_path) or {}
  fetched_at = number(cached.get("fetchedAtMs")) / 1000
  fallback = cached.get("record") if isinstance(cached.get("record"), dict) else None

  now = dt.datetime.now(dt.timezone.utc).isoformat()
  key = api_key()

  if key == "":
    record = dict(fallback or {})
    record.update({
      "schemaVersion": 1,
      "id": AGENT_ID,
      "name": AGENT_NAME,
      "updatedAt": now,
      "ready": bool(fallback and fallback.get("limits")),
      "hasLocalStats": False,
      "hasPromptStats": False,
      "tierLabel": AGENT_NAME,
      "usageStatusText": "Waiting for auth",
      "authHelpText": AUTH_HELP,
    })
    record.setdefault("limits", [])
    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0

  if not args.force and fallback and time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS:
    print(json.dumps(fallback, separators=(",", ":"), sort_keys=True))
    return 0

  probed = probe(key)

  if not probed["ok"]:
    record = dict(fallback) if fallback else {
      "schemaVersion": 1,
      "id": AGENT_ID,
      "name": AGENT_NAME,
      "hasLocalStats": False,
      "hasPromptStats": False,
      "ready": False,
      "tierLabel": AGENT_NAME,
      "limits": [],
    }
    record["updatedAt"] = now
    record["usageStatusText"] = "" if fallback else "OpenCode Go usage unavailable"
    record["authHelpText"] = probed["helpText"]
    if probed.get("transport"):
      record["retryAdvised"] = True
    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": now,
    "ready": True,
    "hasLocalStats": False,
    "hasPromptStats": False,
    "tierLabel": AGENT_NAME,
    "usageStatusText": "",
    "authHelpText": "",
    "limits": probed["limits"],
  }

  write_json(cache_path, {"fetchedAtMs": round(time.time() * 1000), "record": record})
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
