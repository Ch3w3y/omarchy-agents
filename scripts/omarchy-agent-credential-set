#!/usr/bin/python3
# omarchy:summary=Store or clear an API key for one Agents provider
# omarchy:args=<provider-id> [api-key]
# omarchy:hidden=true
"""Write (or, with no key, clear) one provider's entry in the Agents plugin's
own credential store: ~/.config/omarchy/agents/credentials.json.

This is the write side of the panel's settings screen (the gear icon) — it
exists so the QML layer never has to reason about atomic writes or file
permissions itself. The file is created 0600 from the moment its first byte
exists (O_CREAT with an explicit mode, not a post-hoc chmod), and every
rewrite lands via a same-directory temp file plus rename, so a reader never
observes a partial document and a crash mid-write leaves the previous
complete one in place.

The key itself is read from stdin, never taken from argv: /proc/<pid>/cmdline
is world-readable on Linux, so a key passed as an argument is legible to every
other local process for as long as this one runs. Passing the key positionally
still works for interactive use, but it is the insecure path and callers
inside the shell use `--stdin` instead.
"""

from __future__ import annotations

import json
import os
import sys
from pathlib import Path
from typing import Any


def credentials_path() -> Path:
  root = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")) / "omarchy" / "agents"
  root.mkdir(parents=True, exist_ok=True)
  try:
    os.chmod(root, 0o700)
  except OSError:
    pass
  return root / "credentials.json"


def read_store(path: Path) -> dict[str, Any]:
  try:
    data = json.loads(path.read_text(encoding="utf-8"))
    return data if isinstance(data, dict) else {}
  except Exception:
    return {}


def write_store(path: Path, data: dict[str, Any]) -> None:
  tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
  fd = os.open(tmp, os.O_CREAT | os.O_WRONLY | os.O_TRUNC, 0o600)
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      json.dump(data, handle)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise
  os.replace(tmp, path)


def main() -> int:
  args = sys.argv[1:]
  from_stdin = False
  if args and args[0] == "--stdin":
    from_stdin = True
    args = args[1:]

  if not args:
    print("usage: omarchy-agent-credential-set [--stdin] <provider-id> [api-key]", file=sys.stderr)
    return 1

  provider_id = args[0].strip()
  if provider_id == "":
    print("omarchy-agent-credential-set: provider id is required", file=sys.stderr)
    return 1

  if from_stdin:
    # An empty stdin clears the entry, exactly as an omitted argument does.
    api_key = sys.stdin.read().strip()
  else:
    api_key = args[1].strip() if len(args) > 1 else ""

  path = credentials_path()
  store = read_store(path)

  if api_key == "":
    store.pop(provider_id, None)
  else:
    store[provider_id] = {"apiKey": api_key}

  write_store(path, store)
  print(json.dumps({"ok": True, "provider": provider_id, "cleared": api_key == ""}))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
