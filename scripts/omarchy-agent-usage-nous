#!/usr/bin/python3
# omarchy:summary=Print the Nous Portal usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Nous Portal's monthly credit usage into one display-ready JSON
record.

Nous Portal has no plain API key for account/usage lookups — only OAuth
device-code login (the same flow `omarchy-agent-nous-login` runs, and the
same one Hermes Agent and ai-usagebar use with the public `hermes-cli`
client id). This collector owns an independent copy of that OAuth token in
~/.config/omarchy/agents/nous-credentials.json — refreshed here on its own
schedule — rather than sharing ai-usagebar's, because Nous rotates the
refresh token on every use: two tools refreshing the same one would race,
and whichever refreshed second would find its copy already revoked. The one
exception is a one-time bootstrap: if this collector has never run and
ai-usagebar already holds a still-valid Nous token, it's copied in as a
starting point and never read again afterward.

No local session data exists for a hosted subscription, so this collector
is limits-only, the same as OpenRouter/OpenCode Go/Ollama Cloud.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

AGENT_ID = "nous"
AGENT_NAME = "Nous Portal"
AUTH_HELP = "Run `omarchy-agent-nous-login` to sign in with your Nous Portal account."
CLIENT_ID = "hermes-cli"
TOKEN_URL = "https://portal.nousresearch.com/api/oauth/token"
ACCOUNT_URL = "https://portal.nousresearch.com/api/oauth/account"
REFRESH_SKEW_SECONDS = 120
PROBE_MIN_INTERVAL_SECONDS = 20
HTTP_TIMEOUT = 10
USER_AGENT = "omarchy-agents/1.0"

PLAN_KEYS = ("plan", "plan_name", "planName")
TIER_KEYS = ("tier", "subscription_tier", "subscriptionTier")
MONTHLY_CREDIT_KEYS = ("monthly_credits", "monthlyCredits")
CREDITS_REMAINING_KEYS = ("credits_remaining", "creditsRemaining", "subscription_credits_remaining", "subscriptionCreditsRemaining")
PERIOD_END_KEYS = ("period_end", "current_period_end", "currentPeriodEnd", "renewal_at", "renewalAt")
PURCHASED_CREDITS_KEYS = ("purchased_credits_remaining", "purchasedCreditsRemaining", "top_up_credits_remaining", "topUpCreditsRemaining")
TOTAL_USABLE_KEYS = ("total_usable_credits", "totalUsableCredits")


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def config_home() -> Path:
  return Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))


def number(value: Any) -> float:
  try:
    n = float(value)
    return n if n == n and abs(n) != float("inf") else 0.0
  except Exception:
    return 0.0


def read_json(path: Path) -> dict[str, Any] | None:
  try:
    data = json.loads(path.read_text(encoding="utf-8"))
    return data if isinstance(data, dict) else None
  except Exception:
    return None


def write_json_secret(path: Path, data: dict[str, Any]) -> None:
  path.parent.mkdir(parents=True, exist_ok=True)
  try:
    os.chmod(path.parent, 0o700)
  except OSError:
    pass
  tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
  fd = os.open(tmp, os.O_CREAT | os.O_WRONLY | os.O_TRUNC, 0o600)
  with os.fdopen(fd, "w", encoding="utf-8") as handle:
    json.dump(data, handle)
  os.replace(tmp, path)


def write_json(path: Path, data: dict[str, Any]) -> None:
  tmp = path.with_name(path.name + f".tmp{os.getpid()}")
  tmp.write_text(json.dumps(data), encoding="utf-8")
  tmp.replace(path)


def token_store_path() -> Path:
  return config_home() / "omarchy" / "agents" / "nous-credentials.json"


def parse_iso(value: str) -> dt.datetime | None:
  try:
    parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=dt.timezone.utc)
  except Exception:
    return None


def parse_timestamp(value: Any) -> dt.datetime | None:
  if value is None:
    return None
  if isinstance(value, (int, float)):
    seconds = float(value) / 1000.0 if float(value) > 10_000_000_000 else float(value)
    try:
      return dt.datetime.fromtimestamp(seconds, tz=dt.timezone.utc)
    except Exception:
      return None
  return parse_iso(str(value))


def bootstrap_from_ai_usagebar() -> dict[str, Any] | None:
  data = read_json(config_home() / "ai-usagebar" / "credentials.json")
  if not data:
    return None
  nous = data.get("nous")
  if not isinstance(nous, dict):
    return None
  expires_at = parse_timestamp(nous.get("expires_at"))
  if expires_at is None or expires_at <= dt.datetime.now(dt.timezone.utc):
    return None
  access_token = str(nous.get("access_token") or "").strip()
  refresh_token = str(nous.get("refresh_token") or "").strip()
  if not access_token or not refresh_token:
    return None
  return {"access_token": access_token, "refresh_token": refresh_token, "expires_at": expires_at.isoformat()}


def load_token() -> dict[str, Any] | None:
  token = read_json(token_store_path())
  if token and token.get("access_token") and token.get("refresh_token"):
    return token
  imported = bootstrap_from_ai_usagebar()
  if imported:
    write_json_secret(token_store_path(), imported)
    return imported
  return None


def needs_refresh(token: dict[str, Any]) -> bool:
  expires_at = parse_timestamp(token.get("expires_at"))
  if expires_at is None:
    return True
  return dt.datetime.now(dt.timezone.utc) + dt.timedelta(seconds=REFRESH_SKEW_SECONDS) >= expires_at


def refresh_token(refresh: str) -> dict[str, Any] | None:
  body = urllib.parse.urlencode({
    "grant_type": "refresh_token",
    "client_id": CLIENT_ID,
    "refresh_token": refresh,
  }).encode("ascii")
  req = urllib.request.Request(
    TOKEN_URL,
    data=body,
    method="POST",
    headers={
      "Content-Type": "application/x-www-form-urlencoded",
      "x-nous-refresh-token": refresh,
      "Accept": "application/json",
      "User-Agent": USER_AGENT,
    },
  )
  try:
    with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as response:
      payload = json.loads(response.read().decode("utf-8", errors="replace"))
  except Exception:
    return None

  access_token = str(payload.get("access_token") or "").strip()
  new_refresh = str(payload.get("refresh_token") or "").strip()
  expires_in = payload.get("expires_in")
  if not access_token or not new_refresh or not isinstance(expires_in, (int, float)):
    return None
  expires_at = dt.datetime.now(dt.timezone.utc) + dt.timedelta(seconds=float(expires_in))
  token = {"access_token": access_token, "refresh_token": new_refresh, "expires_at": expires_at.isoformat()}
  write_json_secret(token_store_path(), token)
  return token


def first_present(sources: list[dict[str, Any]], keys: tuple[str, ...]) -> Any:
  for source in sources:
    for key in keys:
      if key in source and source[key] is not None:
        return source[key]
  return None


def probe(access_token: str) -> dict[str, Any]:
  req = urllib.request.Request(
    ACCOUNT_URL,
    headers={"Authorization": f"Bearer {access_token}", "Accept": "application/json", "User-Agent": USER_AGENT},
  )
  try:
    with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as response:
      payload = json.loads(response.read().decode("utf-8", errors="replace"))
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      return {"ok": False, "reauth": True, "helpText": "Nous Portal rejected the saved sign-in. " + AUTH_HELP}
    if error.code == 429:
      return {"ok": False, "helpText": "Nous Portal is rate limiting usage checks right now."}
    return {"ok": False, "helpText": f"Nous Portal's account endpoint returned status {error.code}."}
  except Exception:
    return {"ok": False, "transport": True, "helpText": "Couldn't reach Nous Portal. Retrying shortly."}

  if not isinstance(payload, dict) or "error" in payload or "errors" in payload:
    return {"ok": False, "helpText": "Nous Portal's account response didn't match what this collector expects."}

  sources = []
  for key in ("subscription", "paid_service_access"):
    nested = payload.get(key)
    if isinstance(nested, dict):
      sources.append(nested)
  sources.append(payload)

  plan = first_present(sources, PLAN_KEYS)
  tier = first_present(sources, TIER_KEYS)
  monthly_credits = number(first_present(sources, MONTHLY_CREDIT_KEYS))
  credits_remaining = first_present(sources, CREDITS_REMAINING_KEYS)
  period_end = parse_timestamp(first_present(sources, PERIOD_END_KEYS))

  limits: list[dict[str, Any]] = []
  # A monthly allocation of 0 isn't "0% used" — it's no allocation at all
  # (the Free plan, and possibly others with no subscription tier), so there
  # is nothing to compute a percentage against.
  if monthly_credits > 0 and credits_remaining is not None:
    # The account endpoint has returned values like -3e-22 for "exactly
    # empty" — floating-point noise around zero, not a real negative
    # balance — so clamp rather than reject.
    remaining = max(0.0, number(credits_remaining))
    percent = max(0.0, min(1.0, (monthly_credits - remaining) / monthly_credits))
    limits.append({
      "label": "Monthly credits",
      "title": "Monthly",
      "percent": percent,
      "resetsAt": period_end.isoformat() if period_end else "",
    })

  # Credits bought on top of (or instead of) a monthly allocation are a
  # prepaid balance, not a percentage of anything — same shape as
  # OpenRouter's /credits or Fireworks' estimated balance. Nous credits are
  # USD-pegged (ai-usagebar's shared money formatter treats them the same
  # way it treats OpenRouter's and Fireworks'), so this is safe to render
  # with a $ prefix rather than a bare number.
  balance = None
  purchased_remaining = first_present(sources, PURCHASED_CREDITS_KEYS)
  total_usable = number(first_present(sources, TOTAL_USABLE_KEYS))
  if purchased_remaining is not None:
    remaining = max(0.0, number(purchased_remaining))
    if remaining > 0 or total_usable > 0:
      balance = {
        "remaining": max(remaining, total_usable),
        "funded": 0,
        "spent": 0,
        "currency": "USD",
        "estimated": False,
      }

  tier_label = str(plan) if plan else (f"Nous Portal (tier {tier})" if tier is not None else "Nous Portal")
  return {"ok": True, "limits": limits, "balance": balance, "tierLabel": tier_label}


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true", help="ignore the short reuse window and re-probe")
  parser.add_argument("--limits-only", action="store_true", help="accepted for contract parity; every probe here is a limits probe")
  args = parser.parse_args()

  cache_path = cache_root() / f"{AGENT_ID}.json"
  cached = read_json(cache_path) or {}
  fetched_at = number(cached.get("fetchedAtMs")) / 1000
  fallback = cached.get("record") if isinstance(cached.get("record"), dict) else None

  now = dt.datetime.now(dt.timezone.utc).isoformat()
  token = load_token()

  if token is None:
    record = dict(fallback or {})
    record.update({
      "schemaVersion": 1,
      "id": AGENT_ID,
      "name": AGENT_NAME,
      "updatedAt": now,
      "ready": False,
      "hasLocalStats": False,
      "hasPromptStats": False,
      "tierLabel": AGENT_NAME,
      "usageStatusText": "Waiting for auth",
      "authHelpText": AUTH_HELP,
    })
    record.setdefault("limits", [])
    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0

  if not args.force and fallback and time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS:
    print(json.dumps(fallback, separators=(",", ":"), sort_keys=True))
    return 0

  if needs_refresh(token):
    refreshed = refresh_token(token["refresh_token"])
    if refreshed is None:
      # A rejected refresh means the grant is dead — no amount of retrying
      # fixes it, only a fresh login does. Drop the stale token so the next
      # run doesn't keep re-attempting a refresh that can't succeed.
      token_store_path().unlink(missing_ok=True)
      record = dict(fallback) if fallback else {
        "schemaVersion": 1, "id": AGENT_ID, "name": AGENT_NAME,
        "hasLocalStats": False, "hasPromptStats": False, "ready": False,
        "tierLabel": AGENT_NAME, "limits": [],
      }
      record["updatedAt"] = now
      record["usageStatusText"] = "Sign-in expired"
      record["authHelpText"] = "Nous Portal's saved sign-in expired. " + AUTH_HELP
      print(json.dumps(record, separators=(",", ":"), sort_keys=True))
      return 0
    token = refreshed

  probed = probe(token["access_token"])

  if not probed["ok"]:
    record = dict(fallback) if fallback else {
      "schemaVersion": 1, "id": AGENT_ID, "name": AGENT_NAME,
      "hasLocalStats": False, "hasPromptStats": False, "ready": False,
      "tierLabel": AGENT_NAME, "limits": [],
    }
    record["updatedAt"] = now
    record["usageStatusText"] = "" if fallback else "Nous Portal usage unavailable"
    record["authHelpText"] = probed["helpText"]
    if probed.get("transport"):
      record["retryAdvised"] = True
    if probed.get("reauth"):
      token_store_path().unlink(missing_ok=True)
      record["usageStatusText"] = "Sign-in expired"
    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": now,
    "ready": True,
    "hasLocalStats": False,
    "hasPromptStats": False,
    "tierLabel": probed["tierLabel"],
    "usageStatusText": "",
    "authHelpText": "",
    "limits": probed["limits"],
  }
  if probed.get("balance") is not None:
    record["balance"] = probed["balance"]

  write_json(cache_path, {"fetchedAtMs": round(time.time() * 1000), "record": record})
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
